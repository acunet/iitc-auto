<!--
  Marker for a neutral portal.

  Why this exists: the host draws every marker that belongs to a list row as a full balloon — with
  the row's letter when a label is set, and with the row's index number when it is not. Both are
  as loud as the faction pins. A dot icon is the smallest marker the Car App API offers, so neutral
  portals stay visible on the map without competing with the R/E/M markers that say whose area you
  are driving through.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="10dp"
    android:height="10dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#55000000"
        android:strokeWidth="2"
        android:pathData="M12,7 C14.8,7 17,9.2 17,12 C17,14.8 14.8,17 12,17 C9.2,17 7,14.8 7,12 C7,9.2 9.2,7 12,7 Z" />
</vector>
