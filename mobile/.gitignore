# Generated by `python build.py mobile` (README has the steps): never commit,
# always regenerable, ~1.5 MB per build.
app/src/main/assets/total-conversion-build.user.js
app/src/main/assets/plugins/

# NOTE: this used to be a blanket `assets` rule, which also swallowed
# app/src/main/assets/iitc-auto-bridge.js — our own code that the app injects into
# the WebView, and without it a clone builds an app that shows nothing on the car
# screen. Git cannot re-include a file inside an excluded directory, so the rule is
# now spelled out per generated path instead of per directory. Keep it that way.

*.iml
.gradle
local.properties
keystore.properties
.idea
.DS_Store
build
/captures
.externalNativeBuild
