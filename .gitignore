# Android / Gradle
.gradle/
**/build/
local.properties
*.apk
*.aab
captures/

# Signing — NEVER commit these to the repo
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
*.hprof

# OS
Thumbs.db
.DS_Store
desktop.ini

# Scratch / probe artifacts
/tmp/
*.log

# Node dependencies (used by build.py to bundle the IITC userscripts)
node_modules/

# Generated assets from `python build.py mobile` (IITC userscript + plugins).
# Never commit: ~1.5 MB per build and always regenerable.
# Our own bridge userscript sits in the same folder and IS committed; mobile/.gitignore
# spells the generated paths out one by one so it is not swallowed (see the note there).
mobile/app/src/main/assets/total-conversion-build.user.js
mobile/app/src/main/assets/plugins/

# Python bytecode (never commit compiled build scripts)
__pycache__/
*.pyc
