<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      POI category: only MAP_TEMPLATES may be requested.
      Do NOT add NAVIGATION_TEMPLATES / ACCESS_SURFACE — those belong to the Navigation
      category, whose turn-by-turn requirement (NF-1) a portal map app cannot satisfy.
    -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- setCurrentLocationEnabled(true) in the template requires these location permissions;
         without them the host throws "MISSING_PERMISSION: The car app does not have the required
         location permission(s)" and kills the app process. They also have to be requested at runtime. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_dialog_map"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- REQUIRED for the templated host (AAOS): without this the host rejects the app with
             "Min API level not declared in manifest (androidx.car.app.minCarApiLevel)".
             The value is the lowest Car App API level the app actually uses.
             1 = enough for PlaceListMapTemplate. Raise it to 7 if MapWithContentTemplate
             (a surface) is used later. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- GATE 0a NOTE (AAOS): if this activity carries a LAUNCHER intent-filter, the AAOS
             car launcher treats the app as a regular app rather than a templated car app,
             so the host never opens its CarAppService. For template testing on AAOS the
             LAUNCHER filter was removed. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- The CarAppActivity entry point (automotive/AAOS flavour only) lives in
             app/src/automotive/AndroidManifest.xml — the projected flavour does not use it. -->

        <service
            android:name=".ProbeCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>
    </application>
</manifest>
